{
  "_readme": [
    "Маршруты публикации. Это ЕДИНСТВЕННЫЙ файл, который придётся править,",
    "когда соцсеть обновит интерфейс. Код трогать не нужно.",
    "",
    "Селекторы в 'any' проверяются по очереди, срабатывает первый найденный —",
    "поэтому туда складываем варианты на разных языках и разные resource-id.",
    "  {'text': 'Далее'}      — точное совпадение текста",
    "  {'contains': 'Next'}   — подстрока в тексте или content-desc",
    "  {'rid': 'btn_post'}    — resource-id (можно хвост без имени пакета)",
    "  {'desc': 'Опубликовать'} — content-desc",
    "",
    "Операции: wait, tap, optional_tap, type, publish, sleep, back,",
    "          hide_keyboard, dismiss",
    "  optional_tap — не падает, если элемента нет (реклама, туториалы)",
    "  hide_keyboard — жмёт «назад» ТОЛЬКО если клавиатура видна. После",
    "                  ввода описания нужен именно он: голое «назад» при",
    "                  спрятанной клавиатуре уходит с экрана публикации",
    "                  обратно в редактор",
    "  publish      — финальный необратимый тап, слушается DRY_RUN",
    "  $caption     — подставляется описание из задачи",
    "",
    "ВАЖНО: resource-id ниже — стартовые догадки, их надо уточнить под свою",
    "версию приложения. Открой нужный экран на телефоне и выполни:",
    "    python main.py dump",
    "Скрипт напечатает все элементы экрана с их настоящими id."
  ],
  "tiktok": {
    "package": "com.zhiliaoapp.musically",
    "title": "TikTok",
    "steps": [
      {
        "op": "sleep",
        "min": 2,
        "max": 4,
        "desc": "ждём загрузку редактора"
      },
      {
        "op": "optional_tap",
        "any": [
          {
            "text": "Разрешить"
          },
          {
            "text": "Allow"
          }
        ],
        "desc": "запрос доступа к файлам"
      },
      {
        "op": "tap",
        "timeout": 45,
        "any": [
          {
            "text": "Далее"
          },
          {
            "text": "Next"
          },
          {
            "rid": "btn_next"
          }
        ],
        "desc": "из редактора на экран описания"
      },
      {
        "op": "optional_tap",
        "any": [
          {
            "text": "Далее"
          },
          {
            "text": "Next"
          }
        ],
        "desc": "второй Next, если есть шаг со звуком"
      },
      {
        "op": "wait",
        "timeout": 30,
        "any": [
          {
            "rid": "caption_edit"
          },
          {
            "contains": "Опишите"
          },
          {
            "contains": "Describe"
          },
          {
            "contains": "Добавьте описание"
          },
          {
            "contains": "Add description"
          }
        ],
        "desc": "экран публикации"
      },
      {
        "op": "tap",
        "any": [
          {
            "rid": "caption_edit"
          },
          {
            "contains": "Опишите"
          },
          {
            "contains": "Describe"
          },
          {
            "contains": "Добавьте описание"
          },
          {
            "contains": "Add description"
          }
        ],
        "desc": "фокус в поле описания"
      },
      {
        "op": "type",
        "value": "$caption"
      },
      {
        "op": "hide_keyboard",
        "desc": "убрать клавиатуру"
      },
      {
        "op": "sleep",
        "min": 1,
        "max": 2
      },
      {
        "op": "publish",
        "timeout": 20,
        "any": [
          {
            "text": "Опубликовать"
          },
          {
            "text": "Post"
          },
          {
            "rid": "btn_post"
          },
          {
            "desc": "Опубликовать"
          },
          {
            "desc": "Post"
          }
        ],
        "desc": "ФИНАЛЬНАЯ КНОПКА"
      }
    ]
  },
  "reels": {
    "package": "com.instagram.android",
    "title": "Instagram Reels",
    "_note": [
      "Instagram НЕ принимает видео через Intent: проверены content://,",
      "file://, явная ShareHandlerActivity и пункт «Reels» в окне MIUI —",
      "во всех случаях открывается главная лента, будто ничего не прислали.",
      "Поэтому здесь open_uri: заходим в ленту Reels и дальше идём как",
      "человек — камера, галерея, свежее видео, подпись, «Поделиться».",
      "Видео к этому моменту уже залито на телефон и лежит в галерее первым."
    ],
    "open_uri": "instagram://reels_home",
    "steps": [
      {
        "op": "sleep",
        "min": 3,
        "max": 5,
        "desc": "ждём ленту Reels"
      },
      {
        "op": "tap_xy",
        "x": 0.061,
        "y": 0.071,
        "desc": "камера Reels (в играющей ленте дерево не снимается, только по месту)"
      },
      {
        "op": "sleep",
        "min": 3,
        "max": 5
      },
      {
        "op": "optional_tap",
        "any": [
          {
            "text": "Начать новое видео"
          },
          {
            "text": "Start new video"
          }
        ],
        "desc": "черновик с прошлого раза — начинаем новое"
      },
      {
        "op": "tap_xy",
        "x": 0.09,
        "y": 0.885,
        "desc": "миниатюра галереи (у неё нет ни текста, ни id)"
      },
      {
        "op": "wait",
        "timeout": 30,
        "any": [
          {
            "rid": "gallery_title_text"
          },
          {
            "contains": "Новое видео Reels"
          }
        ],
        "desc": "галерея"
      },
      {
        "op": "tap_first",
        "timeout": 20,
        "any": [
          {
            "rid": "gallery_grid_item_thumbnail",
            "contains": "идео"
          }
        ],
        "desc": "свежее видео"
      },
      {
        "op": "tap",
        "timeout": 30,
        "any": [
          {
            "rid": "clips_right_action_button"
          },
          {
            "text": "Далее"
          }
        ],
        "desc": "из редактора дальше"
      },
      {
        "op": "optional_tap",
        "any": [
          {
            "rid": "clips_right_action_button"
          }
        ],
        "desc": "ещё раз «Далее», если первый тап ушёл в подсказку"
      },
      {
        "op": "wait",
        "timeout": 30,
        "any": [
          {
            "rid": "caption_input_text_view"
          },
          {
            "contains": "Добавьте подпись"
          },
          {
            "contains": "Напишите подпись"
          }
        ],
        "desc": "экран публикации"
      },
      {
        "op": "tap",
        "any": [
          {
            "rid": "caption_input_text_view"
          },
          {
            "contains": "Добавьте подпись"
          },
          {
            "contains": "Напишите подпись"
          }
        ],
        "desc": "фокус в поле подписи"
      },
      {
        "op": "type",
        "value": "$caption"
      },
      {
        "op": "hide_keyboard",
        "desc": "убрать клавиатуру"
      },
      {
        "op": "sleep",
        "min": 1,
        "max": 2
      },
      {
        "op": "publish",
        "timeout": 25,
        "any": [
          {
            "rid": "share_button"
          },
          {
            "text": "Поделиться"
          },
          {
            "text": "Share"
          }
        ],
        "desc": "ФИНАЛЬНАЯ КНОПКА"
      }
    ]
  },
